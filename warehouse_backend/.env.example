# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
API_PREFIX=/api

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Odoo Connection
ODOO_URL=http://localhost:8069
ODOO_DB=odoo15
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Redis (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
